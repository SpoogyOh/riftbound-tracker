{
  "name": "riftbound-tracker",
  "private": true,
  "scripts": {
    "catalog:update": "node scripts/import-openrift.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:tools": "tsc -p tsconfig.tools.json",
    "catalog:sql": "npm run build:tools && node .cache/tools/scripts/export-supabase-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:tools && node --test tests/*.test.mjs",
    "test:database": "npm run build:tools && node --test tests/database.test.mjs tests/catalog-import.test.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
