{
  "name": "riftbound-tracker",
  "private": true,
  "scripts": {
    "catalog:update": "node scripts/import-openrift.mjs",
    "build:tools": "tsc -p tsconfig.tools.json",
    "catalog:sql": "npm run build:tools && node .cache/tools/scripts/export-supabase-catalog.mjs",
    "standalone:build": "npm run build:browser && node scripts/build-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:tools && npm run build:browser && node --test tests/*.test.mjs",
    "test:database": "npm run build:tools && node --test tests/database.test.mjs tests/catalog-import.test.mjs",
    "test:browser": "playwright test",
    "build:browser": "node scripts/build-browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
